generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  RESTAURANT
  DELIVERY_PARTNER
  ADMIN
  CUSTOMER_SUPPORT
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String?
  fullName         String
  phoneNumber      String?
  role             Role          @default(CUSTOMER)
  status           AccountStatus @default(ACTIVE)
  statusChangedBy  String?
  statusChangedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([role])
  @@index([status])
  @@index([status, role])
}
