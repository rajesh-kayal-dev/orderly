generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER         @map("customer")
  RESTAURANT       @map("restaurant")
  DELIVERY_PARTNER @map("delivery_partner")
  ADMIN            @map("admin")
  CUSTOMER_SUPPORT @map("customer_support")
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String?
  fullName         String
  phoneNumber      String?
  role             Role          @default(CUSTOMER)
  status           AccountStatus @default(ACTIVE)
  statusChangedBy  String?
  statusChangedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([role])
  @@index([status])
  @@index([status, role])
}

model GuestSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tokenHash])
  @@index([expiresAt])
}
