# ==========================================
# Orderly Environment Configuration Template
# ==========================================

# PostgreSQL Database
DATABASE_URL=postgresql://orderly:orderly@localhost:5432/orderly_db

# Service Ports (defaults shown; each container starts only its own service)
PORT=3001

# Kafka Event Broker
# Local development: the broker above is PLAINTEXT and unauthenticated, so none
# of the four variables below need to be set.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=orderly
KAFKA_LOG_LEVEL=info
# Managed brokers: set these four. KAFKA_SSL=true negotiates TLS.
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SASL_MECHANISM=plain

# Frontend (CORS allowlist; comma-separated in production)
FRONTEND_URL=http://localhost:3000

# Inter-service URLs
RESTAURANT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004

# Authentication & Security
JWT_SECRET=orderly_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=1d
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ADMIN_EMAIL=admin@orderly.com
ADMIN_PASSWORD=password123

# Delivery Dispatch Tuning
DISPATCH_OFFER_TIMEOUT_MS=15000
DISPATCH_INITIAL_RADIUS_KM=3
DISPATCH_MAX_RADIUS_KM=15

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to ${protocol}://${host}/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@orderly.com
